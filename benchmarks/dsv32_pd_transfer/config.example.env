BENCH_OUTPUT_LEN=32
BENCH_NUM_PROMPTS=5
BENCH_NUM_WARMUPS=1
BENCH_REPETITIONS=3
BENCH_SEED=0
BENCH_REQUEST_RATE=inf
BENCH_MAX_CONCURRENCY=1
