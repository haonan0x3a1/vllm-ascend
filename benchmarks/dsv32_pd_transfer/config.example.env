# Copy to config.env and point RUNTIME_CONFIG at the already working PD config.

RUNTIME_CONFIG=/workspace/w50062541/code/vllm-ascend/examples/disaggregated_prefill_v1/dsv32_sparse_offload_poc/config.env

# One campaign must use the same revision and settings for both transfer modes.
BENCH_CAMPAIGN=same-host-pd-transfer-v1
