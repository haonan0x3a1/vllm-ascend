# Copy this file to config.env and adjust it once for the target server.

WORKSPACE_DIR=/workspace
REPO_DIR=/workspace/vllm-ascend
MODEL_PATH=/models/DeepSeek-V3.2-W4A8C8
LOG_DIR=/workspace/logs
OUTPUT_DIR=/workspace/output

CANN_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh
CUSTOM_OPP_ENV=/workspace/custom-opp/opp/vendors/customize/bin/set_env.bash
RUNTIME_PYTHON=/usr/local/bin/python

API_HOST=127.0.0.1
API_PORT=18100
DEVICES=0,1,2,3,4,5,6,7
TP_SIZE=8

SERVED_MODEL_PREFIX=deepseek-v3.2-sparse-profile
HF_OVERRIDES='{"num_hidden_layers":61}'
MAX_MODEL_LEN=4096
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=256
BLOCK_SIZE=128
GPU_MEMORY_UTILIZATION=0.90
ENGINE_SEED=1024

HCCL_OP_EXPANSION_MODE=AIV
HCCL_BUFFSIZE=512
OMP_NUM_THREADS=10

ENABLE_PREFILL_MC2=true
ENABLE_MLAPO=false
ENABLE_FLASHCOMM1=false

# Comma-separated input lengths. Each plus BENCH_OUTPUT_LEN must not exceed
# MAX_MODEL_LEN. Values above index_topk=2048 exercise true sparse selection.
BENCH_INPUT_LENGTHS=3072
BENCH_OUTPUT_LEN=32
BENCH_NUM_PROMPTS=5
BENCH_NUM_WARMUPS=1
BENCH_REPETITIONS=3
BENCH_CAMPAIGN=4k-smoke-v1
BENCH_SEED=0
BENCH_REQUEST_RATE=inf
BENCH_MAX_CONCURRENCY=1
