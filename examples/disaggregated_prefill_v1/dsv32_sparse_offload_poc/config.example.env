# Copy this file to config.env and adjust it once for the target server.

WORKSPACE_DIR=/workspace
REPO_DIR=/workspace/vllm-ascend
MODEL_PATH=/models/DeepSeek-V3.2-W4A8C8
LOG_DIR=/workspace/logs
OUTPUT_DIR=/workspace/output

CANN_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh
CUSTOM_OPP_ENV=/workspace/custom-opp/opp/vendors/customize/bin/set_env.bash
MOONCAKE_PYTHON=/workspace/venvs/dsv32-mooncake/bin/python

HOST_IP=REPLACE_WITH_NODE_IP
PROXY_PORT=18000
PREFILL_API_PORT=18001
DECODE_API_PORT=18002
PREFILL_KV_PORT_BASE=22000
DECODE_KV_PORT_BASE=22100

PREFILL_DEVICES=0,1,2,3,4,5,6,7
DECODE_DEVICES=8,9,10,11,12,13,14,15
TP_SIZE=8

SERVED_MODEL_NAME=deepseek-v3.2-pd-real61-4k
HF_OVERRIDES='{"num_hidden_layers":61}'
MAX_MODEL_LEN=4096
INDEX_TOPK=2048
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=256
BLOCK_SIZE=128
GPU_MEMORY_UTILIZATION=0.90
SEED=1024

HCCL_OP_EXPANSION_MODE=AIV
HCCL_BUFFSIZE=512
OMP_NUM_THREADS=10
ASCEND_TRANSFER_TIMEOUT=600
VLLM_MOONCAKE_ABORT_REQUEST_TIMEOUT=480

ENABLE_PREFILL_MC2=true
ENABLE_MLAPO=false
ENABLE_FLASHCOMM1=false
SPARSE_KV_OFFLOAD_MODE=host
# npu_staging keeps the verified baseline. host_relay is a diagnostic pinned
# Host relay. memfabric_bm sends Full KV through BM G2G/HOST_TCP while Mooncake
# carries only the Indexer KV tensors.
SPARSE_KV_TRANSFER_MODE=npu_staging

# Keep disabled for headline latency/throughput measurements. Enable only for
# a targeted profile-one run from benchmarks/dsv32_pd_transfer.
ENABLE_TORCH_PROFILER=false
TORCH_PROFILER_DIR=/workspace/output/dsv32-pd-transfer-profile/traces
# Emit one Host-observed aggregate per TP worker for a single-request probe.
SPARSE_KV_STAGE_METRICS=false
# Give EngineCore and TP workers time to release Connector and BM resources.
SHUTDOWN_TIMEOUT_SECONDS=120

MEMFABRIC_HYBRID_LIB_DIR=/usr/local/python3.11.10/lib/python3.11/site-packages/memfabric_hybrid/lib
MEMFABRIC_BM_PROTOCOL=host_tcp
MEMFABRIC_BM_POOL_BYTES=1073741824
MEMFABRIC_BM_STORE_PORT_BASE=22200
MEMFABRIC_BM_HCOM_PORT_BASE=22300
MEMFABRIC_BM_ID=74
