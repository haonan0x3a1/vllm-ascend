# Copy this file to config.env and adjust it once for the target server.

WORKSPACE_DIR=/workspace
REPO_DIR=/workspace/vllm-ascend
MODEL_PATH=/models/DeepSeek-V3.2-W4A8C8
LOG_DIR=/workspace/logs
OUTPUT_DIR=/workspace/output

CANN_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh
CUSTOM_OPP_ENV=/workspace/custom-opp/opp/vendors/customize/bin/set_env.bash
MOONCAKE_PYTHON=/workspace/venvs/dsv32-mooncake/bin/python

HOST_IP=REPLACE_WITH_NODE_IP
PROXY_PORT=18000
PREFILL_API_PORT=18001
DECODE_API_PORT=18002
PREFILL_KV_PORT_BASE=36000
DECODE_KV_PORT_BASE=36400

PREFILL_DEVICES=0,1,2,3,4,5,6,7
DECODE_DEVICES=8,9,10,11,12,13,14,15
TP_SIZE=8

SERVED_MODEL_NAME=deepseek-v3.2-pd-real61-4k
HF_OVERRIDES='{"num_hidden_layers":61}'
MAX_MODEL_LEN=4096
INDEX_TOPK=2048
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=256
BLOCK_SIZE=128
GPU_MEMORY_UTILIZATION=0.90
SEED=1024

HCCL_OP_EXPANSION_MODE=AIV
HCCL_BUFFSIZE=512
OMP_NUM_THREADS=10
ASCEND_TRANSFER_TIMEOUT=600
VLLM_MOONCAKE_ABORT_REQUEST_TIMEOUT=480

ENABLE_PREFILL_MC2=true
ENABLE_MLAPO=false
ENABLE_FLASHCOMM1=false
SPARSE_KV_OFFLOAD_MODE=host
